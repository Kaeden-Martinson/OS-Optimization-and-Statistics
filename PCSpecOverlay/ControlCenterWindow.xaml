<Window x:Class="PCSpecOverlay.ControlCenterWindow" Icon="Optiframe.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCSpecOverlay"
        xmlns:core="clr-namespace:PCSpecOverlay.Core"
        Title="Optiframe" Width="1040" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="Manual" Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Overview: one ruled reading cell -->
        <Style x:Key="ReadingCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="16,12,16,14" />
        </Style>
        <Style x:Key="ReadingKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="ReadingValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Text" Value="—" />
        </Style>
        <Style x:Key="ReadingUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
        <Style x:Key="ReadingSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Ticks" TargetType="UniformGrid">
            <Setter Property="Columns" Value="10" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
    <TabControl x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="OnPageChanged"
                Foreground="{DynamicResource Text}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <!-- Tab bar; the app name (left) and version + theme switch (right) are drawn over it by the window -->
                    <Border DockPanel.Dock="Top" Height="40" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <StackPanel IsItemsHost="True" Orientation="Horizontal" Margin="104,0,156,0" />
                    </Border>
                    <!-- This name lets screen readers (UI Automation) reach the page content -->
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </DockPanel>
            </ControlTemplate>
        </TabControl.Template>

        <!-- ===================== OVERVIEW ===================== -->
        <TabItem Header="Overview" Tag="{StaticResource Icon.Overview}" Style="{StaticResource TopTab}">
            <DockPanel>
                <!-- Status line: what is running, power, overlay; Stop/Resume when relevant -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="StopButton" Content="Stop optimizations" Style="{StaticResource Btn}" Tag="Danger"
                                    Click="OnStopOptimizations" Padding="10,2" Margin="8,0,0,0" />
                            <Button x:Name="ResumeButton" Content="Resume" Style="{StaticResource Btn}" Tag="Primary"
                                    Click="OnResume" Visibility="Collapsed" Padding="10,2" Margin="8,0,0,0" />
                        </StackPanel>
                        <DockPanel VerticalAlignment="Center">
                            <Rectangle x:Name="StatusLed" DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource Good}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusLine" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Banners: only shown when something needs attention -->
                        <StackPanel x:Name="Banners" Margin="16,12,16,0" />

                        <!-- Four readings in a ruled grid -->
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                            <UniformGrid Columns="4">
                                <Border Style="{StaticResource ReadingCell}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="TFpsSource" DockPanel.Dock="Right" Style="{StaticResource ReadingKey}" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Text="FRAME RATE" Style="{StaticResource ReadingKey}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TFps" Style="{StaticResource ReadingValue}" />
                                            <TextBlock Text="fps" Style="{StaticResource ReadingUnit}" />
                                        </StackPanel>
                                        <TextBlock x:Name="TFpsSub" Style="{StaticResource ReadingSub}" />
                                        <UniformGrid x:Name="FpsTicks" Style="{StaticResource Ticks}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReadingCell}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="TGpuName" DockPanel.Dock="Right" Style="{StaticResource ReadingKey}" />
                                            <TextBlock Text="GPU" Style="{StaticResource ReadingKey}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TGpu" Style="{StaticResource ReadingValue}" />
                                            <TextBlock x:Name="TGpuUnit" Text="°C" Style="{StaticResource ReadingUnit}" />
                                        </StackPanel>
                                        <TextBlock x:Name="TGpuSub" Style="{StaticResource ReadingSub}" />
                                        <UniformGrid x:Name="GpuTicks" Style="{StaticResource Ticks}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReadingCell}">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Style="{StaticResource ReadingKey}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TCpu" Style="{StaticResource ReadingValue}" />
                                            <TextBlock Text="°C" Style="{StaticResource ReadingUnit}" />
                                        </StackPanel>
                                        <TextBlock x:Name="TCpuSub" Style="{StaticResource ReadingSub}" />
                                        <UniformGrid x:Name="CpuTicks" Style="{StaticResource Ticks}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ReadingCell}" BorderThickness="0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="TRamTotal" DockPanel.Dock="Right" Style="{StaticResource ReadingKey}" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Text="MEMORY" Style="{StaticResource ReadingKey}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TRam" Style="{StaticResource ReadingValue}" />
                                            <TextBlock Text="GB" Style="{StaticResource ReadingUnit}" />
                                        </StackPanel>
                                        <TextBlock x:Name="TRamSub" Style="{StaticResource ReadingSub}" />
                                        <UniformGrid x:Name="RamTicks" Style="{StaticResource Ticks}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <!-- Frame-rate chart and what the app did -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,12,16,16">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="FpsChartRange" DockPanel.Dock="Right" Style="{StaticResource ReadingKey}" FontFamily="Cascadia Mono, Consolas" />
                                        <TextBlock Text="FRAME RATE · LAST 10 MINUTES" Style="{StaticResource ReadingKey}" />
                                    </DockPanel>
                                    <Canvas x:Name="FpsChart" Height="170" Margin="0,10,0,0" ClipToBounds="True" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,12,16,16">
                                <TextBlock Text="EVENTS" Style="{StaticResource ReadingKey}" Margin="0,0,0,8" />
                                <TextBlock x:Name="EventsEmpty" Style="{StaticResource Body}" Visibility="Collapsed"
                                           Text="Nothing yet. Gaming mode, Game Boost, optimizer changes and alerts appear here." />
                                <ItemsControl x:Name="EventList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7" AutomationProperties.Name="{Binding Message}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time, StringFormat=HH:mm}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                           Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Signal}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Hot}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== OPTIMIZER ===================== -->
        <TabItem Header="Optimizer" Tag="{StaticResource Icon.Optimizer}" Style="{StaticResource TopTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="24,18,24,14">
                        <Button x:Name="FixAllButton" DockPanel.Dock="Right" Tag="Primary" Style="{StaticResource Btn}"
                                Click="OnFixAll" VerticalAlignment="Center" Content="Apply recommendations" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Optimizer" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource Body}"
                                       Text="Nothing changes until you press a button. Every change is recorded and can be undone." />
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="RestartBanner" Visibility="Collapsed" Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Border BorderBrush="{DynamicResource Signal}" BorderThickness="2,0,0,0" Padding="22,10,24,10">
                            <DockPanel>
                                <Button x:Name="RestartButton" DockPanel.Dock="Right" Tag="Primary" Style="{StaticResource Btn}"
                                        VerticalAlignment="Center" Click="OnRestartBrowser" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock x:Name="RestartTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RestartDetail" Style="{StaticResource Body}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Border>

                    <!-- One ruled table: mark, setting, now, recommended, effect, action -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="24,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="SETTING" Style="{StaticResource Key}" />
                            <TextBlock Grid.Column="2" Text="NOW" Style="{StaticResource Key}" />
                            <TextBlock Grid.Column="3" Text="RECOMMENDED" Style="{StaticResource Key}" />
                            <TextBlock Grid.Column="4" Text="EFFECT AND DRAWBACK" Style="{StaticResource Key}" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="CheckList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LedgerRow}" Padding="0">
                                    <Border x:Name="Edge" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="22,9,24,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <core:Icon x:Name="Mark" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Good}"
                                                       Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="DetailText" Text="{Binding Detail}" Style="{StaticResource Small}" Visibility="Collapsed" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Mono}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Recommended}" Style="{StaticResource Mono}"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,1,12,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,0,12,0" />
                                            <Button x:Name="ActionButton" Grid.Column="5" Content="{Binding ActionLabel}" Style="{StaticResource Btn}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="0" Padding="10,3"
                                                    Click="OnCheckAction" Visibility="Collapsed"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='{}{0} action'}" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Warn">
                                        <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Warning}" />
                                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Signal}" />
                                        <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Signal}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Info">
                                        <Setter TargetName="Mark" Property="Data" Value="{StaticResource Icon.Info}" />
                                        <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Muted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAction}" Value="True">
                                        <Setter TargetName="ActionButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                        <Setter TargetName="DetailText" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionLabel}" Value="Fix">
                                        <Setter TargetName="ActionButton" Property="Tag" Value="Primary" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- What's using the PC -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="24,7" Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="WHAT'S USING YOUR PC" Style="{StaticResource Key}" />
                            <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Key}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="GPU" Style="{StaticResource Key}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource Key}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="LOWER DURING GAMES" Style="{StaticResource Key}" Margin="22,0,0,0" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LedgerRow}" Padding="24,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Gpu}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Ram}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Muted}" />
                                        <CheckBox Grid.Column="4" Style="{StaticResource Switch}" Margin="22,0,0,0" HorizontalAlignment="Left"
                                                  IsChecked="{Binding IsBoostTarget, Mode=TwoWay}" IsEnabled="{Binding CanLower}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Lower {0} during games'}" />
                                        <Button Grid.Column="5" Content="End" Style="{StaticResource Btn}" MinWidth="0" Padding="12,3"
                                                HorizontalAlignment="Right" Click="OnEndApp" IsEnabled="{Binding CanEnd}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='End {0}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Small}" Margin="24,8,24,24"
                               Text="Apps are grouped by name (Edge's many processes count as one) and limited to your account. Windows system processes can't be ended or lowered. Ending an app asks first and closes it without saving." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== GAMING ===================== -->
        <TabItem Header="Gaming" Tag="{StaticResource Icon.Gaming}" Style="{StaticResource TopTab}">
            <DockPanel>
                <!-- Shown while gaming mode is on or paused -->
                <Border x:Name="GamingBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="GamingPause" Style="{StaticResource Btn}" MinWidth="0" Padding="10,2" Click="OnStopOptimizations"
                                    AutomationProperties.Name="Pause gaming mode">
                                <StackPanel Orientation="Horizontal">
                                    <core:Icon Data="{StaticResource Icon.Pause}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Pause" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="GamingResume" Content="Resume" Style="{StaticResource Btn}" Tag="Primary" Padding="10,2"
                                    Click="OnResume" Visibility="Collapsed" />
                        </StackPanel>
                        <Rectangle x:Name="GamingLed" Width="6" Height="6" Fill="{DynamicResource Good}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="GamingBarText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="24,18,24,14">
                            <TextBlock Text="Gaming" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource Body}"
                                       Text="While a game is in front, gaming mode takes these steps and puts everything back afterwards. If you change a setting yourself during a game, your choice is kept." />
                        </StackPanel>

                        <!-- The four steps, left to right -->
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
                            <UniformGrid Columns="4">
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,12,16,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoGamingMode}"
                                                      AutomationProperties.Name="Turn gaming mode on automatically" />
                                            <TextBlock Text="01" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                            <TextBlock Text="Detect" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="A game from your list renders at 30+ FPS in front." />
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Margin="8,0,0,0"
                                                       Text="{Binding Value, ElementName=EnterSlider, StringFormat='after {0:0} s'}" />
                                            <Slider x:Name="EnterSlider" Minimum="2" Maximum="30" TickFrequency="1" Value="{Binding GamingEnterSeconds}"
                                                    AutomationProperties.Name="Switch on after this many seconds" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,12,16,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GamingPowerMode}"
                                                      AutomationProperties.Name="Switch power mode to Best performance" />
                                            <TextBlock Text="02" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                            <TextBlock Text="Power" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                                                   Text="Switch to Best performance for a higher CPU boost. Your power mode is remembered and put back." />
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,12,16,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GamingProcessPriority}"
                                                      AutomationProperties.Name="Prioritize the game (Game Boost)" />
                                            <TextBlock Text="03" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                            <TextBlock Text="Boost" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                                                   Text="The game one step up (Above normal), apps you choose one step down. Never touches Windows system processes." />
                                        <TextBlock x:Name="BoostTargetsText" Style="{StaticResource Small}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="16,12,16,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="04" Style="{StaticResource Mono}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                                            <TextBlock Text="Restore" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="Everything is put back once no game is in front (Alt+Tab grace)." />
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Margin="8,0,0,0"
                                                       Text="{Binding Value, ElementName=ExitSlider, StringFormat='after {0:0} s'}" />
                                            <Slider x:Name="ExitSlider" Minimum="5" Maximum="120" TickFrequency="5" Value="{Binding GamingExitSeconds}"
                                                    AutomationProperties.Name="Switch back after this many seconds" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>

                        <!-- Games -->
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,7" Margin="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="148" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GAME" Style="{StaticResource Key}" />
                                <TextBlock Grid.Column="1" Text="MATCH BY" Style="{StaticResource Key}" />
                                <TextBlock Grid.Column="2" Text="OVERLAY" Style="{StaticResource Key}" />
                                <TextBlock Grid.Column="3" Text="OPTIMIZE" Style="{StaticResource Key}" />
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="RuleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LedgerRow}" Padding="24,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="148" />
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Match, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Game match" />
                                            <ComboBox Grid.Column="1" Margin="0,0,8,0" MinWidth="0" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding Kind}" AutomationProperties.Name="Match by">
                                                <ComboBoxItem Content="Window title" Tag="{x:Static local:GameMatchKind.WindowTitle}" />
                                                <ComboBoxItem Content="App name" Tag="{x:Static local:GameMatchKind.ProcessName}" />
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" Margin="0,0,8,0" MinWidth="0" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding LayoutChoice}" AutomationProperties.Name="Overlay layout for this game">
                                                <ComboBoxItem Content="Default" Tag="Default" />
                                                <ComboBoxItem Content="Strip" Tag="Compact" />
                                                <ComboBoxItem Content="Panel" Tag="Expanded" />
                                            </ComboBox>
                                            <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Optimize}" HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{Binding Match, StringFormat='Optimize while {0} is in front'}" />
                                            <Button Grid.Column="4" Style="{StaticResource Btn}" MinWidth="0" Padding="6,4" HorizontalAlignment="Right"
                                                    Click="OnRemoveRule" AutomationProperties.Name="{Binding Match, StringFormat='Remove {0}'}">
                                                <core:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource LedgerRow}" Padding="24,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="OnAddRule" AutomationProperties.Name="Add game">
                                    <StackPanel Orientation="Horizontal">
                                        <core:Icon Data="{StaticResource Icon.Plus}" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add game" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="NewRule" Margin="0,0,8,0" AutomationProperties.Name="New game window title" KeyDown="OnNewRuleKey" />
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Small}" Margin="24,6,24,0"
                                   Text="A window counts as a game when it renders at 30+ FPS and matches a rule. Match browser games by part of the window title (e.g. Starve.io) and other games by app name. Turn off Optimize to detect a game without changing anything." />

                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,7" Margin="0,22,0,0">
                            <TextBlock Text="RECENTLY SEEN" Style="{StaticResource Key}" />
                        </Border>
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LedgerRow}" Padding="24,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource Btn}" MinWidth="0" Padding="10,2"
                                                    Click="OnAddRecent" IsEnabled="{Binding CanAdd}" />
                                            <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RecentEmpty" Style="{StaticResource Small}" Margin="24,8,24,0"
                                   Text="Nothing yet. Games appear here while they render in front." />

                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,7" Margin="0,22,0,0">
                            <TextBlock Text="OPTIONS" Style="{StaticResource Key}" />
                        </Border>
                        <Border Style="{StaticResource LedgerRow}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DetectFullscreenGames}">
                                <StackPanel>
                                    <TextBlock Text="Detect fullscreen games" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="Shows fullscreen apps that render steadily as games, even if they aren't listed." />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LedgerRow}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OptimizeFullscreenGames}">
                                <StackPanel>
                                    <TextBlock Text="Also optimize unlisted fullscreen apps" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="Off by default: a fullscreen video would also count. Adding the game to the list is the safer choice." />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource LedgerRow}" Margin="0,0,0,24">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameBoost}">
                                <StackPanel>
                                    <TextBlock Text="Always prioritize games (even without gaming mode)" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="Applies the same one-step priority changes whenever a listed game is in front." />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ===================== OVERLAY ===================== -->
        <TabItem Header="Overlay" Tag="{StaticResource Icon.Overlay}" Style="{StaticResource TopTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26,32,32">
                    <TextBlock Text="Overlay" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Lead}" Text="How the in-game panel looks and where it sits. Changes apply immediately." />

                    <TextBlock Text="APPEARANCE" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox x:Name="ShowOverlay" Style="{StaticResource Switch}" Margin="0,0,0,14" Click="OnShowOverlay">
                                <StackPanel>
                                    <TextBlock Text="Show the overlay" FontSize="13" />
                                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Body}" />
                                </StackPanel>
                            </CheckBox>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Layout" FontSize="13" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Layout}" AutomationProperties.Name="Overlay layout">
                                    <ComboBoxItem Content="Strip (one line)" Tag="Compact" />
                                    <ComboBoxItem Content="Panel" Tag="Expanded" />
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Overlay theme" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="Dark reads best over most games." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" SelectedValuePath="Tag" SelectedValue="{Binding OverlayTheme}"
                                          AutomationProperties.Name="Overlay theme">
                                    <ComboBoxItem Content="Always dark" Tag="AlwaysDark" />
                                    <ComboBoxItem Content="Always light" Tag="AlwaysLight" />
                                    <ComboBoxItem Content="Same as app" Tag="SameAsApp" />
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Display" FontSize="13" VerticalAlignment="Center" />
                                <ComboBox x:Name="DisplayBox" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Monitor}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Position" FontSize="13" VerticalAlignment="Center" />
                                <ComboBox x:Name="PositionBox" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Position}"
                                          AutomationProperties.Name="Overlay position">
                                    <ComboBoxItem Content="Top right" Tag="TopRight" />
                                    <ComboBoxItem Content="Top left" Tag="TopLeft" />
                                    <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                                    <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                                    <ComboBoxItem Content="Custom (pinned spot)" Tag="Custom" />
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.3" Maximum="1" TickFrequency="0.05" Value="{Binding Opacity}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Text="{Binding Value, ElementName=OpacitySlider, StringFormat='{}{0:P0}'}" />
                            </Grid>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Text size" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.75" Maximum="1.75" TickFrequency="0.05" Value="{Binding Scale}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Text="{Binding Value, ElementName=ScaleSlider, StringFormat='{}{0:P0}'}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="METRICS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <UniformGrid Columns="2">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowFrameTime}" Margin="0,0,24,12" Content="Frame time" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowOnePercentLow}" Margin="0,0,0,12" Content="1% low FPS" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowGpu}" Margin="0,0,24,12" Content="GPU" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowVram}" Margin="0,0,0,12" Content="GPU memory (VRAM)" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowCpu}" Margin="0,0,24,12" Content="CPU" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowRam}" Margin="0,0,0,12" Content="RAM" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowSlowdowns}" Margin="0,0,24,0" Content="Slowdown warnings" />
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="BEHAVIOR" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Move the overlay" FontSize="13" />
                                    <TextBlock Style="{StaticResource Small}" Text="Unlocks it so you can drag it anywhere on any screen; press Pin on the overlay to lock it there. Clicks pass through to your game whenever it's pinned." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Move overlay" Style="{StaticResource Btn}" Click="OnMoveOverlay" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FPS refresh" FontSize="13" />
                                    <TextBlock Style="{StaticResource Small}" Text="How often the overlay redraws. Once a second uses the least CPU." />
                                </StackPanel>
                                <ComboBox x:Name="FpsRefreshBox" Grid.Column="1" SelectedValuePath="Tag"
                                          SelectedValue="{Binding FpsRefreshMs}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sensor refresh" FontSize="13" />
                                    <TextBlock Style="{StaticResource Small}" Text="GPU, CPU and memory. Slower uses less power." />
                                </StackPanel>
                                <ComboBox x:Name="StatsRefreshBox" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding StatsRefreshMs}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,14" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GpuRendering}">
                                <StackPanel>
                                    <TextBlock Text="Draw the overlay with the graphics chip" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="Off by default. Measured on this laptop: about 0.3% of one CPU core less, but about 145 MB more memory, because the graphics driver loads into the app. Takes effect after the app restarts." />
                                </StackPanel>
                            </CheckBox>
                            <Button x:Name="RestartAppButton" Content="Restart the app now" Style="{StaticResource Btn}" Tag="Primary"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" Click="OnRestartApp" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== ALERTS ===================== -->
        <TabItem Header="Alerts" Tag="{StaticResource Icon.Temperature}" Style="{StaticResource TopTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26,32,32">
                    <TextBlock Text="Temperatures &amp; alerts" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Lead}"
                               Text="Warning levels color the overlay amber; hot levels color it red. Two kinds of notification: confirmed slowdowns (the driver or Windows reports the hardware is slowing itself down) and temperature warnings (above your levels, which isn't a fault on its own)." />

                    <TextBlock Text="LEVELS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="GPU warning" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="GpuWarn" Grid.Column="1" Minimum="50" Maximum="105" TickFrequency="1" Value="{Binding GpuTempWarn}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Foreground="{DynamicResource Warn}" Text="{Binding Value, ElementName=GpuWarn, StringFormat='{}{0:0} °C'}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="GPU hot" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="GpuHot" Grid.Column="1" Minimum="50" Maximum="110" TickFrequency="1" Value="{Binding GpuTempHot}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Foreground="{DynamicResource Hot}" Text="{Binding Value, ElementName=GpuHot, StringFormat='{}{0:0} °C'}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="CPU warning" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="CpuWarn" Grid.Column="1" Minimum="50" Maximum="105" TickFrequency="1" Value="{Binding CpuTempWarn}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Foreground="{DynamicResource Warn}" Text="{Binding Value, ElementName=CpuWarn, StringFormat='{}{0:0} °C'}" />
                            </Grid>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="CPU hot" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="CpuHot" Grid.Column="1" Minimum="50" Maximum="110" TickFrequency="1" Value="{Binding CpuTempHot}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Foreground="{DynamicResource Hot}" Text="{Binding Value, ElementName=CpuHot, StringFormat='{}{0:0} °C'}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Small}" Margin="0,10,0,0"
                                       Text="CPU temperature comes from the hottest ACPI thermal zone, which tracks the CPU package closely on laptops but isn't a per-core sensor." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Alerts}" Margin="0,0,0,14">
                                <TextBlock Text="Notify me about slowdowns and high temperatures" FontSize="13" />
                            </CheckBox>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Only if it lasts" FontSize="13" />
                                    <TextBlock Style="{StaticResource Small}" Text="Brief spikes are ignored." />
                                </StackPanel>
                                <Slider x:Name="AfterSlider" Grid.Column="1" Minimum="5" Maximum="120" TickFrequency="5" Value="{Binding AlertAfterSeconds}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Text="{Binding Value, ElementName=AfterSlider, StringFormat='{}{0:0} s'}" />
                            </Grid>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="At most once every" FontSize="13" />
                                    <TextBlock Style="{StaticResource Small}" Text="Per kind of alert. If the same problem keeps going, reminders slow to hourly after the third." />
                                </StackPanel>
                                <Slider x:Name="CooldownSlider" Grid.Column="1" Minimum="1" Maximum="120" TickFrequency="1" Value="{Binding AlertCooldownMinutes}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Text="{Binding Value, ElementName=CooldownSlider, StringFormat='{}{0:0} min'}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== GENERAL ===================== -->
        <TabItem Header="Settings" Tag="{StaticResource Icon.Settings}" Style="{StaticResource TopTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26,32,32">
                    <TextBlock Text="Settings" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Lead}" Text="Startup, shortcut, power use and history." />

                    <TextBlock Text="STARTUP" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Click="OnStartupToggle">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontSize="13" />
                                    <TextBlock x:Name="StartupStatus" Style="{StaticResource Body}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <DockPanel>
                            <ComboBox x:Name="AppearanceBox" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      SelectedValuePath="Tag" SelectedValue="{Binding Appearance}" AutomationProperties.Name="Theme">
                                <ComboBoxItem Tag="MatchWindows" Content="Match Windows" />
                                <ComboBoxItem Tag="Light" Content="Light" />
                                <ComboBoxItem Tag="Dark" Content="Dark" />
                            </ComboBox>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Theme" FontSize="13" />
                                <TextBlock Style="{StaticResource Body}" Text="Light, dark, or follow the Windows app setting. The in-game overlay stays dark." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="UPDATES" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock x:Name="UpdateVersion" FontSize="13" />
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Body}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="CheckUpdatesButton" Content="Check now" Style="{StaticResource Btn}" Click="OnCheckUpdates" Margin="0,0,8,8" />
                                <Button x:Name="InstallUpdateButton" Content="Download and install" Style="{StaticResource Btn}" Tag="Primary"
                                        Click="OnInstallUpdate" Visibility="Collapsed" Margin="0,0,8,8" />
                                <Button x:Name="ReleasePageButton" Content="What's new" Style="{StaticResource Btn}"
                                        Click="OnReleasePage" Visibility="Collapsed" Margin="0,0,8,8" />
                            </WrapPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Check automatically once a day" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="Asks GitHub for the latest release; nothing personal is sent. Updates are only installed when you choose to, after the download's checksum is verified." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SHORTCUT" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Text="Show or hide the overlay" FontSize="13" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="OnHotkeyKey" AutomationProperties.Name="Overlay shortcut"
                                         ToolTip="Click here and press the new shortcut" />
                                <Button Grid.Column="1" Content="Use this shortcut" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="OnApplyHotkey" />
                                <TextBlock x:Name="HotkeyResult" Grid.Column="2" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0" Text="Click the box, press the keys you want (e.g. Ctrl+Alt+P), then choose Use this shortcut. If another app already uses it, your current shortcut stays." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="POWER AND HISTORY" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox x:Name="SleepSwitch" Style="{StaticResource Switch}" IsChecked="{Binding LetGpuSleep}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Let the laptop GPU sleep" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="When the NVIDIA GPU is powered down, don't wake it just to read its sensors. The overlay shows it as sleeping." />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HistoryEnabled}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Keep performance history" FontSize="13" />
                                    <TextBlock Style="{StaticResource Body}" Text="The last 10 minutes stay in memory for the graphs. A short summary of each gaming session is saved on this PC; nothing is uploaded." />
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Keep session summaries for" FontSize="13" VerticalAlignment="Center" />
                                <Slider x:Name="RetentionSlider" Grid.Column="1" Minimum="1" Maximum="90" TickFrequency="1" Value="{Binding HistoryRetentionDays}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueLabel}" Text="{Binding Value, ElementName=RetentionSlider, StringFormat='{}{0:0} days'}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RECENT SESSIONS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <ItemsControl x:Name="SessionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" Foreground="{DynamicResource Text}" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="SessionsEmpty" Style="{StaticResource Small}" Text="No sessions saved yet." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RESET" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Restore defaults" Style="{StaticResource Btn}" Click="OnResetSettings" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Restore default settings" FontSize="13" />
                                <TextBlock Style="{StaticResource Body}" Text="Resets preferences on every page. Your games list and lowered apps are kept, and Windows settings the app changed aren't touched (undo those on the Optimizer or Diagnostics page)." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===================== DIAGNOSTICS ===================== -->
        <TabItem Header="Diagnostics" Tag="{StaticResource Icon.Diagnostics}" Style="{StaticResource TopTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,26,32,32">
                    <TextBlock Text="Diagnostics" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Lead}" Text="What works on this PC, what the app has changed, and recent problems." />

                    <TextBlock Text="STATUS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <ItemsControl x:Name="StatusList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="ACTIONS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Copy diagnostic report" Style="{StaticResource Btn}" Click="OnCopyReport" Margin="0,0,8,8" />
                                <Button Content="Open log" Style="{StaticResource Btn}" Click="OnOpenLog" Margin="0,0,8,8" />
                                <Button Content="Open data folder" Style="{StaticResource Btn}" Click="OnOpenData" Margin="0,0,8,8" />
                                <Button Content="Undo every change the app made" Style="{StaticResource Btn}" Tag="Danger" Click="OnUndoEverything" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="ActionResult" Style="{StaticResource Body}" Foreground="{DynamicResource Text}" />
                            <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0"
                                       Text="The report includes the version, settings, sensor availability and recent errors. Your user name and profile paths are replaced with placeholders." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RECENT EVENTS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource CardBox}">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss'}" Style="{StaticResource Small}" Margin="0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Area}" Style="{StaticResource Small}" Margin="0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Body}" Margin="0"
                                                   Foreground="{Binding Level, Converter={x:Static local:LevelBrush.Instance}}"
                                                   />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    <!-- App name over the left of the tab bar -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Margin="16,0,0,0" IsHitTestVisible="False">
        <core:Icon Data="{StaticResource Icon.Mark}" Width="16" Height="16" VerticalAlignment="Center" />
        <TextBlock Text="Optiframe" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <!-- Version and the light/dark switch over the right of the tab bar -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="40" Margin="0,0,12,0">
        <TextBlock x:Name="VersionLabel" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource Muted}"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="LightButton" Style="{StaticResource IconToggle}" Tag="{StaticResource Icon.Sun}"
                              AutomationProperties.Name="Light theme" ToolTip="Light theme" Click="OnLightTheme" />
                <ToggleButton x:Name="DarkButton" Style="{StaticResource IconToggle}" Tag="{StaticResource Icon.Moon}"
                              AutomationProperties.Name="Dark theme" ToolTip="Dark theme" Click="OnDarkTheme" />
            </StackPanel>
        </Border>
    </StackPanel>
    </Grid>
</Window>
