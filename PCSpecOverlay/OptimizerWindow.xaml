<Window x:Class="PCSpecOverlay.OptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Spec Optimizer" Width="760" Height="820" MinWidth="640" MinHeight="520"
        WindowStartupLocation="Manual" Background="#0D0F12" Foreground="#F3F5F6"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#76B900" />
        <SolidColorBrush x:Key="AccentHover" Color="#8BD100" />
        <SolidColorBrush x:Key="Card" Color="#15181C" />
        <SolidColorBrush x:Key="CardBorder" Color="#20252B" />
        <SolidColorBrush x:Key="Muted" Color="#8C959E" />
        <SolidColorBrush x:Key="Faint" Color="#5E666E" />
        <SolidColorBrush x:Key="Good" Color="#76B900" />
        <SolidColorBrush x:Key="Warn" Color="#F5B731" />
        <SolidColorBrush x:Key="Info" Color="#4FA3F7" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Rounded button: green when Tag="Primary", outlined otherwise -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E9EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3A4148" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#5A636C" />
                                <Setter TargetName="B" Property="Background" Value="#1D2126" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Primary">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#0B0D10" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentHover}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentHover}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS/Windows-style toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="22">
                            <Border x:Name="Track" CornerRadius="11" Background="#2A3036" BorderBrush="#3A4148" BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#C9CED2" HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="#0B0D10" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" CornerRadius="3" Background="#2E343A" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#48505A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,32">

            <!-- Header -->
            <TextBlock Text="Optimizer" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Finds the settings and background apps that hold back your FPS. Every change can be undone." />

            <!-- System checks -->
            <DockPanel Margin="0,28,0,10">
                <Button x:Name="FixAllButton" DockPanel.Dock="Right" Content="Fix all" Tag="Primary"
                        Style="{StaticResource Btn}" Click="OnFixAll" />
                <TextBlock Text="SYSTEM CHECKS" Style="{StaticResource SectionTitle}" />
            </DockPanel>

            <!-- Shown when a browser is still running from before its graphics setting changed -->
            <Border x:Name="RestartBanner" Visibility="Collapsed" Background="#1A2410" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RestartTitle" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Your windows and tabs reopen automatically. Anything unsaved on a page (a form, a game in progress) is lost." />
                    </StackPanel>
                    <Button x:Name="RestartButton" Grid.Column="1" Tag="Primary" Style="{StaticResource Btn}"
                            VerticalAlignment="Center" Click="OnRestartBrowsers" />
                </Grid>
            </Border>

            <ItemsControl x:Name="CheckList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="16,13" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Margin="0,6,0,0" Fill="{StaticResource Good}" />
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Good}" />
                                    <Button x:Name="ActionButton" Content="{Binding ActionLabel}" Style="{StaticResource Btn}"
                                            Click="OnCheckAction" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Warn">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Warn}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Info">
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Info}" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource Muted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasAction}" Value="True">
                                <Setter TargetName="ActionButton" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActionLabel}" Value="Fix">
                                <Setter TargetName="ActionButton" Property="Tag" Value="Primary" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Game Boost -->
            <TextBlock Text="GAME BOOST" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Prioritize the game you're playing" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="When a game is in front and rendering, it gets higher CPU priority and the apps you mark below get lower priority. Everything goes back to normal when you leave the game. This shares CPU time, not the GPU — a GPU-heavy job like AI training still competes for graphics power." />
                        <TextBlock x:Name="BoostTargetsText" FontSize="12" Foreground="{StaticResource Faint}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="BoostToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"
                              Margin="0,2,0,0" AutomationProperties.Name="Game Boost"
                              Checked="OnBoostToggled" Unchecked="OnBoostToggled" />
                </Grid>
            </Border>

            <!-- Automatic gaming mode -->
            <TextBlock Text="AUTOMATIC GAMING MODE" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Switch to full performance while you play" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="A few seconds after a game starts, Windows switches to Best performance and Game Boost turns on. About 20 seconds after you stop playing, both go back to how they were, so you get speed while gaming and battery life and quieter fans the rest of the time." />
                            <TextBlock x:Name="GamingStatus" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Foreground="{StaticResource Faint}" />
                        </StackPanel>
                        <CheckBox x:Name="GamingToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                  Margin="0,2,0,0" AutomationProperties.Name="Automatic gaming mode"
                                  Checked="OnGamingToggled" Unchecked="OnGamingToggled" />
                    </Grid>

                    <TextBlock Text="Games that aren't fullscreen" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <TextBox x:Name="GamesBox" FontSize="12.5" Padding="8,6" Background="#0F1215" Foreground="#E6E9EB"
                             BorderBrush="#2A3036" CaretBrush="#E6E9EB" AutomationProperties.Name="Games list"
                             LostKeyboardFocus="OnGamesEdited" KeyDown="OnGamesKeyDown" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="Fullscreen games are detected automatically. For browser or windowed games, list part of the window title or the app name, separated by commas (e.g. Starve.io, Terraria)." />
                </StackPanel>
            </Border>

            <!-- Top apps -->
            <TextBlock Text="WHAT'S USING YOUR PC" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16,10,16,6">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="APP" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource ColHead}" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="GPU" Style="{StaticResource ColHead}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="MEMORY" Style="{StaticResource ColHead}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="LOWER DURING GAMES" Style="{StaticResource ColHead}" Margin="22,0,0,0" />
                    </Grid>
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Num}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Gpu}" Style="{StaticResource Num}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Ram}" Style="{StaticResource Num}"
                                                   Foreground="{StaticResource Muted}" />
                                        <CheckBox Grid.Column="4" Style="{StaticResource Switch}" Margin="22,0,0,0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsBoostTarget, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Lower {0} during games'}" />
                                        <Button Grid.Column="5" Content="End" Style="{StaticResource Btn}" MinWidth="0"
                                                Padding="12,3" HorizontalAlignment="Right" Click="OnEndApp"
                                                IsEnabled="{Binding CanEnd}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='End {0}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Margin="2,8,0,0" FontSize="11.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap"
                       Text="Apps are grouped by name (Edge's many processes count as one). Ending an app closes it without saving." />
        </StackPanel>
    </ScrollViewer>
</Window>
