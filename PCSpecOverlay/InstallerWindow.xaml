<Window x:Class="PCSpecOverlay.InstallerWindow" Icon="Optiframe.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PCSpecOverlay.Core"
        Title="Optiframe Setup" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="30,26,30,26">
        <StackPanel Orientation="Horizontal">
            <core:Icon Data="{StaticResource Icon.Mark}" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock x:Name="Heading" Style="{StaticResource H1}" FontSize="22" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Intro" Style="{StaticResource Lead}" Margin="0,10,0,0" />

        <StackPanel x:Name="Options" Margin="0,18,0,0">
            <CheckBox x:Name="Option1" Style="{StaticResource Switch}" Margin="0,0,0,10" IsChecked="True" />
            <CheckBox x:Name="Option2" Style="{StaticResource Switch}" Margin="0,0,0,4" />
        </StackPanel>

        <Border x:Name="ResultBox" Style="{StaticResource CardBox}" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ResultText" Style="{StaticResource Body}" Margin="0" Foreground="{DynamicResource Text}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="Secondary" Content="Cancel" Style="{StaticResource Btn}" Margin="0,0,10,0" Click="OnCancel" IsCancel="True" />
            <Button x:Name="Primary" Tag="Primary" Style="{StaticResource Btn}" Click="OnPrimary" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
