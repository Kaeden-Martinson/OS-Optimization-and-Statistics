<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PCSpecOverlay</AssemblyName>
    <RootNamespace>PCSpecOverlay</RootNamespace>
    <Product>Optiframe</Product>
    <AssemblyTitle>Optiframe</AssemblyTitle>
    <ApplicationIcon>Optiframe.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Release package: one framework-dependent exe (needs the .NET 8 Desktop Runtime) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- WPF and WinForms both define Application, Color, etc. Keep WinForms out of the global usings. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Optiframe.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PCSpecOverlay.Tests" />
  </ItemGroup>

  <!-- Where releases are published ("owner/name" on GitHub). Empty = update checks report "not set up". -->
  <PropertyGroup>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">Kaeden-Martinson/OS-Optimization-and-Statistics</UpdateRepository>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.*" />
    <PackageReference Include="System.Management" Version="8.0.*" />
  </ItemGroup>

</Project>
