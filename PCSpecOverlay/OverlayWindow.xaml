<Window x:Class="PCSpecOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCSpecOverlay"
        Title="Optiframe overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <ResourceDictionary>
            <!-- The overlay's own colors (O.*), swapped by OverlayWindow.ApplyTheme; never the app's colors -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Overlay.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Foreground" Value="{DynamicResource O.Muted}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="34" />
            </Style>
            <Style x:Key="Num" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource O.Text}" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Text" Value="—" />
            </Style>
            <Style x:Key="Unit" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Foreground" Value="{DynamicResource O.Muted}" />
                <Setter Property="Margin" Value="2,0,9,1" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
            <Style x:Key="State" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontStyle" Value="Italic" />
                <Setter Property="Foreground" Value="{DynamicResource O.Muted}" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="BarTrack" TargetType="Border">
                <Setter Property="Height" Value="2" />
                <Setter Property="Background" Value="{DynamicResource O.Track}" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="BarFill" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource O.Text}" />
                <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            </Style>
            <!-- Strip cells: the same padding everywhere, a divider before every cell but the first -->
            <Style x:Key="Cell" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource O.Line2}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
                <Setter Property="Padding" Value="10,4,10,4" />
            </Style>
            <!-- A cell's line: left-aligned, so any slack sits at the cell's right end -->
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Runs of a cell's line, so its label, numbers and units share one baseline -->
            <Style x:Key="SLabel" TargetType="Run">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Foreground" Value="{DynamicResource O.Muted}" />
            </Style>
            <Style x:Key="SNum" TargetType="Run">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource O.Text}" />
                <Setter Property="Text" Value="—" />
            </Style>
            <Style x:Key="SUnit" TargetType="Run">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Foreground" Value="{DynamicResource O.Muted}" />
            </Style>
            <!-- Gives every cell the FPS number's line height, so the cells share one baseline too -->
            <Style x:Key="SStrut" TargetType="Run">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Text" Value="&#x200B;" />
            </Style>
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource O.Text}" />
                <Setter Property="Padding" Value="5,0,5,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="BadgeText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="8.5" />
                <Setter Property="Foreground" Value="{DynamicResource O.Solid}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Move mode only: a handle bar with the Pin button; above the panel, or below it (row 2) near the top edge -->
        <Border x:Name="MoveHandle" Visibility="Collapsed" Background="{DynamicResource O.Text}" Height="22" Margin="0,0,0,4">
            <DockPanel>
                <Button x:Name="PinButton" DockPanel.Dock="Right" Click="OnPin" Focusable="False" Cursor="Hand" Margin="2"
                        AutomationProperties.Name="Pin the overlay here">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource O.Solid}" Padding="7,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9,3 H15 L14,9 L18,13 H6 L10,9 Z M12,13 V21" Stroke="{DynamicResource O.Text}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Pin" Margin="5,0,0,0" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10.5"
                                               Foreground="{DynamicResource O.Text}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Path Data="M12,3 V21 M3,12 H21 M9,6 L12,3 L15,6 M9,18 L12,21 L15,18 M6,9 L3,12 L6,15 M18,9 L21,12 L18,15"
                          Stroke="{DynamicResource O.Solid}" StrokeThickness="1.6" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" />
                    <TextBlock Text="Drag to move" Margin="5,0,0,0" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="10.5"
                               Foreground="{DynamicResource O.Solid}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Left-aligned so a wider handle bar never stretches the panel -->
        <Grid x:Name="PanelHost" Grid.Row="1" HorizontalAlignment="Left">
        <Border x:Name="Frame" Background="{DynamicResource O.Bg}" BorderBrush="{DynamicResource O.Line}" BorderThickness="1">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <!-- ============ Panel: the full readout (stored as "Expanded") ============ -->
                <StackPanel x:Name="ExpandedLayout" MinWidth="220" Visibility="Collapsed">
                    <!-- The readings below set the panel's width; the header fits in it (the GPU name trims) -->
                    <local:FollowWidth>
                    <DockPanel Margin="10,5,10,5">
                        <Border x:Name="Badge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="8,0,0,0">
                            <TextBlock x:Name="BadgeText" Style="{StaticResource BadgeText}" />
                        </Border>
                        <TextBlock x:Name="FpsSource" DockPanel.Dock="Right" Style="{StaticResource Label}" Width="Auto"
                                   FontFamily="Cascadia Mono, Consolas" FontWeight="Normal" Margin="8,0,0,0" />
                        <TextBlock Text="OPTIFRAME" DockPanel.Dock="Left" Style="{StaticResource Label}" Width="Auto" />
                        <TextBlock x:Name="GpuName" Style="{StaticResource Label}" Width="Auto" FontWeight="Normal" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    </local:FollowWidth>
                    <Border Height="1" Background="{DynamicResource O.Line}" />

                    <Grid Margin="10,7,10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FpsValue" Style="{StaticResource Num}" FontSize="32" MinWidth="76" />
                            <TextBlock Text="FPS" Style="{StaticResource Unit}" Margin="5,0,0,5" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                            <StackPanel x:Name="FrameTimeRow" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="FrameTime" Style="{StaticResource Num}" FontSize="11.5" MinWidth="34" />
                                <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="3,0,0,1" />
                            </StackPanel>
                            <StackPanel x:Name="LowRow" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="1% " Style="{StaticResource Unit}" Margin="0,0,0,1" />
                                <TextBlock x:Name="LowFps" Style="{StaticResource Num}" FontSize="11.5" MinWidth="27" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <local:FollowWidth>
                        <TextBlock x:Name="FpsHint" Visibility="Collapsed" FontFamily="Segoe UI" FontSize="9.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource O.Muted}" Margin="10,0,10,5" />
                    </local:FollowWidth>

                    <!-- Worst frame of each update, newest on the right: spikes are stutters -->
                    <Border x:Name="TraceArea" Height="24" BorderBrush="{DynamicResource O.Line2}" BorderThickness="0,1,0,1">
                        <Canvas x:Name="TraceCanvas" ClipToBounds="True">
                            <Polyline x:Name="TraceLine" Stroke="{DynamicResource O.Text}" StrokeThickness="1" StrokeLineJoin="Round" />
                        </Canvas>
                    </Border>

                    <StackPanel Margin="10,6,10,8">
                        <DockPanel x:Name="GpuRow" Margin="0,0,0,5">
                            <TextBlock Text="GPU" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,1,8,0" />
                            <StackPanel>
                                <StackPanel x:Name="GpuValues" Orientation="Horizontal">
                                    <TextBlock x:Name="GpuTemp" Style="{StaticResource Num}" MinWidth="23" />
                                    <TextBlock Text="°C" Style="{StaticResource Unit}" />
                                    <TextBlock x:Name="GpuLoad" Style="{StaticResource Num}" MinWidth="23" />
                                    <TextBlock Text="%" Style="{StaticResource Unit}" />
                                    <TextBlock x:Name="GpuClock" Style="{StaticResource Num}" MinWidth="34" />
                                    <TextBlock Text="MHz" Style="{StaticResource Unit}" />
                                    <TextBlock x:Name="GpuPower" Style="{StaticResource Num}" MinWidth="23" />
                                    <TextBlock Text="W" Style="{StaticResource Unit}" Margin="2,0,0,1" />
                                </StackPanel>
                                <TextBlock x:Name="GpuState" Style="{StaticResource State}" />
                                <Border x:Name="GpuTrack" Style="{StaticResource BarTrack}">
                                    <Border x:Name="GpuBar" Style="{StaticResource BarFill}">
                                        <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel x:Name="VramRow" Margin="0,0,0,5">
                            <TextBlock Text="VRAM" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="VramUsed" Style="{StaticResource Num}" MinWidth="31" />
                                <TextBlock x:Name="VramTotal" Style="{StaticResource Unit}" Text="/ — GB" Margin="4,0,0,1" MinWidth="42" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel x:Name="CpuRow" Margin="0,0,0,5">
                            <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,1,8,0" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CpuTemp" Style="{StaticResource Num}" MinWidth="23" />
                                    <TextBlock Text="°C" Style="{StaticResource Unit}" />
                                    <TextBlock x:Name="CpuLoad" Style="{StaticResource Num}" MinWidth="23" />
                                    <TextBlock Text="%" Style="{StaticResource Unit}" />
                                    <TextBlock x:Name="CpuClock" Style="{StaticResource Num}" MinWidth="26" />
                                    <TextBlock Text="GHz" Style="{StaticResource Unit}" Margin="2,0,0,1" />
                                </StackPanel>
                                <Border Style="{StaticResource BarTrack}">
                                    <Border x:Name="CpuBar" Style="{StaticResource BarFill}">
                                        <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel x:Name="RamRow">
                            <TextBlock Text="RAM" Style="{StaticResource Label}" Margin="0,0,8,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RamUsed" Style="{StaticResource Num}" MinWidth="31" />
                                <TextBlock x:Name="RamTotal" Style="{StaticResource Unit}" Text="/ — GB" Margin="4,0,0,1" MinWidth="42" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Why the hardware is slowing down; only shown while it is. The chips wrap inside the panel's width -->
                        <local:FollowWidth>
                            <WrapPanel x:Name="LimitsRow" Visibility="Collapsed" Margin="0,8,0,-4" />
                        </local:FollowWidth>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Strip: one ruled line (stored as "Compact"; the default) ============ -->
                <!-- Each cell is one line of Runs on one baseline; gaps: label to value 6, number to unit 3,
                     between values 8. Whitespace between the Runs would show, so each line stays on one source line.
                     A hidden copy of the line at its widest usual reading (999 FPS, 99.9 ms, 100° 100%) holds the cell's
                     width in the real fonts, so readings don't resize it; any slack sits at the cell's right end. -->
                <StackPanel x:Name="CompactLayout" Orientation="Horizontal">
                    <Border Style="{StaticResource Cell}" BorderThickness="0">
                        <Grid>
                            <TextBlock Style="{StaticResource CellText}" Visibility="Hidden"><Run Style="{StaticResource SNum}" FontSize="17" Text="999" /><InlineUIContainer><Border Width="3" /></InlineUIContainer><Run Style="{StaticResource SUnit}" Text="FPS" /></TextBlock>
                            <TextBlock x:Name="CFpsText" Style="{StaticResource CellText}"><Run Style="{StaticResource SNum}" x:Name="CFps" FontSize="17" /><InlineUIContainer><Border Width="3" /></InlineUIContainer><Run Style="{StaticResource SUnit}" Text="FPS" /></TextBlock>
                        </Grid>
                    </Border>
                    <Border x:Name="CFrameTimeBox" Style="{StaticResource Cell}">
                        <Grid>
                            <TextBlock Style="{StaticResource CellText}" Visibility="Hidden"><Run Style="{StaticResource SStrut}" /><Run Style="{StaticResource SNum}" Text="99.9" /><InlineUIContainer><Border Width="3" /></InlineUIContainer><Run Style="{StaticResource SUnit}" Text="ms" /></TextBlock>
                            <TextBlock x:Name="CFrameTimeText" Style="{StaticResource CellText}"><Run Style="{StaticResource SStrut}" /><Run Style="{StaticResource SNum}" x:Name="CFrameTime" /><InlineUIContainer><Border Width="3" /></InlineUIContainer><Run Style="{StaticResource SUnit}" Text="ms" /></TextBlock>
                        </Grid>
                    </Border>
                    <Border x:Name="CGpuBox" Style="{StaticResource Cell}">
                        <Grid>
                            <TextBlock Style="{StaticResource CellText}" Visibility="Hidden"><Run Style="{StaticResource SStrut}" /><Run Style="{StaticResource SLabel}" Text="GPU" /><InlineUIContainer><Border Width="6" /></InlineUIContainer><Run Style="{StaticResource SNum}" Text="100°" /><InlineUIContainer><Border Width="8" /></InlineUIContainer><Run Style="{StaticResource SNum}" Text="100%" /></TextBlock>
                            <TextBlock x:Name="CGpuText" Style="{StaticResource CellText}"><Run Style="{StaticResource SStrut}" /><Run Style="{StaticResource SLabel}" Text="GPU" /><InlineUIContainer><Border Width="6" /></InlineUIContainer><Run Style="{StaticResource SUnit}" x:Name="CGpuState" FontStyle="Italic" /><Run Style="{StaticResource SNum}" x:Name="CGpuTemp" /><InlineUIContainer><Border Width="8" /></InlineUIContainer><Run Style="{StaticResource SNum}" x:Name="CGpuLoad" /></TextBlock>
                        </Grid>
                    </Border>
                    <Border x:Name="CCpuBox" Style="{StaticResource Cell}">
                        <Grid>
                            <TextBlock Style="{StaticResource CellText}" Visibility="Hidden"><Run Style="{StaticResource SStrut}" /><Run Style="{StaticResource SLabel}" Text="CPU" /><InlineUIContainer><Border Width="6" /></InlineUIContainer><Run Style="{StaticResource SNum}" Text="100°" /><InlineUIContainer><Border Width="8" /></InlineUIContainer><Run Style="{StaticResource SNum}" Text="100%" /></TextBlock>
                            <TextBlock x:Name="CCpuText" Style="{StaticResource CellText}"><Run Style="{StaticResource SStrut}" /><Run Style="{StaticResource SLabel}" Text="CPU" /><InlineUIContainer><Border Width="6" /></InlineUIContainer><Run Style="{StaticResource SNum}" x:Name="CCpuTemp" /><InlineUIContainer><Border Width="8" /></InlineUIContainer><Run Style="{StaticResource SNum}" x:Name="CCpuLoad" /></TextBlock>
                        </Grid>
                    </Border>
                    <!-- The slowdown chip's cell is kept while slowdowns are shown at all, sized for the longer word, so it can come and go -->
                    <Border x:Name="CLimitBox" Style="{StaticResource Cell}" Visibility="Collapsed">
                        <Border x:Name="CLimit" Padding="6,0,6,1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="POWER" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="9" Visibility="Hidden" />
                                <TextBlock x:Name="CLimitText" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Border>
                    <Border x:Name="CBadgeBox" Style="{StaticResource Cell}" Visibility="Collapsed">
                        <Border x:Name="CBadge" Style="{StaticResource Badge}" Visibility="Visible">
                            <TextBlock x:Name="CBadgeText" Style="{StaticResource BadgeText}" />
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
            <!-- Move mode only: dashed outline around the panel -->
            <Rectangle x:Name="MoveOutline" Visibility="Collapsed" Stroke="{DynamicResource O.Text}" StrokeThickness="1"
                       StrokeDashArray="3 2" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
