<Window x:Class="PCSpecOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Spec Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <SolidColorBrush x:Key="LabelBrush" Color="#8C959E" />
        <SolidColorBrush x:Key="ValueBrush" Color="#F3F5F6" />
        <SolidColorBrush x:Key="UnitBrush" Color="#69727B" />
        <SolidColorBrush x:Key="TrackBrush" Color="#22FFFFFF" />

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,14,0" />
            <Setter Property="Width" Value="34" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Text" Value="—" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource UnitBrush}" />
            <Setter Property="Margin" Value="2,0,10,1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="State" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="{StaticResource UnitBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" CornerRadius="8" Background="#EB0B0D10" BorderBrush="#24FFFFFF" BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="7,0,0,7" />

            <!-- ============ Expanded layout ============ -->
            <StackPanel x:Name="ExpandedLayout" Grid.Column="1" Margin="13,9,14,11" MinWidth="232">
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="PERFORMANCE" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9.5"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <Border x:Name="Badge" Visibility="Collapsed" Background="{StaticResource Accent}"
                            CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeText" FontFamily="Segoe UI" FontWeight="Bold" FontSize="8.5" Foreground="#0B0D10" />
                    </Border>
                    <TextBlock x:Name="GpuName" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="14,0,0,0"
                               FontFamily="Segoe UI" FontSize="9.5" Foreground="{StaticResource UnitBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FpsValue" Style="{StaticResource Value}" FontSize="30" FontWeight="Bold" MinWidth="50" />
                        <TextBlock Text="FPS" Style="{StaticResource Unit}" FontWeight="SemiBold" Margin="5,0,0,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel x:Name="FrameTimeRow" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="FrameTime" Style="{StaticResource Value}" FontSize="12" />
                            <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="2,0,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="LowRow" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="1% LOW " Style="{StaticResource Unit}" Margin="0" />
                            <TextBlock x:Name="LowFps" Style="{StaticResource Value}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="FpsHint" Visibility="Collapsed" FontFamily="Segoe UI" FontSize="9.5"
                           Foreground="{StaticResource UnitBrush}" Margin="0,1,0,0" />

                <Border x:Name="Divider" Height="1" Background="#1CFFFFFF" Margin="0,8,0,7" />

                <!-- GPU -->
                <DockPanel x:Name="GpuRow" Margin="0,0,0,6">
                    <TextBlock Text="GPU" Style="{StaticResource Label}" />
                    <StackPanel>
                        <StackPanel x:Name="GpuValues" Orientation="Horizontal">
                            <TextBlock x:Name="GpuLoad" Style="{StaticResource Value}" MinWidth="24" />
                            <TextBlock Text="%" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="GpuTemp" Style="{StaticResource Value}" MinWidth="20" />
                            <TextBlock Text="°C" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="GpuClock" Style="{StaticResource Value}" MinWidth="34" />
                            <TextBlock Text="MHz" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="GpuPower" Style="{StaticResource Value}" MinWidth="18" />
                            <TextBlock Text="W" Style="{StaticResource Unit}" Margin="2,0,0,1" />
                        </StackPanel>
                        <TextBlock x:Name="GpuState" Style="{StaticResource State}" />
                        <Border x:Name="GpuTrack" Style="{StaticResource BarTrack}">
                            <Border x:Name="GpuBar" Style="{StaticResource BarFill}">
                                <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <DockPanel x:Name="VramRow" Margin="0,0,0,6">
                    <TextBlock Text="VRAM" Style="{StaticResource Label}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VramUsed" Style="{StaticResource Value}" MinWidth="24" />
                        <TextBlock x:Name="VramTotal" Style="{StaticResource Unit}" Text="/ — GB" Margin="4,0,0,1" />
                    </StackPanel>
                </DockPanel>

                <!-- CPU -->
                <DockPanel x:Name="CpuRow" Margin="0,0,0,6">
                    <TextBlock Text="CPU" Style="{StaticResource Label}" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CpuLoad" Style="{StaticResource Value}" MinWidth="24" />
                            <TextBlock Text="%" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="CpuTemp" Style="{StaticResource Value}" MinWidth="20" />
                            <TextBlock Text="°C" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="CpuClock" Style="{StaticResource Value}" MinWidth="26" />
                            <TextBlock Text="GHz" Style="{StaticResource Unit}" Margin="2,0,0,1" />
                        </StackPanel>
                        <Border Style="{StaticResource BarTrack}">
                            <Border x:Name="CpuBar" Style="{StaticResource BarFill}">
                                <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <DockPanel x:Name="RamRow">
                    <TextBlock Text="RAM" Style="{StaticResource Label}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RamUsed" Style="{StaticResource Value}" MinWidth="24" />
                        <TextBlock x:Name="RamTotal" Style="{StaticResource Unit}" Text="/ — GB" Margin="4,0,0,1" />
                    </StackPanel>
                </DockPanel>

                <!-- Why the hardware is slowing down; only shown while it is -->
                <WrapPanel x:Name="LimitsRow" Visibility="Collapsed" Margin="0,9,0,-4" />
            </StackPanel>

            <!-- ============ Compact layout: one line ============ -->
            <StackPanel x:Name="CompactLayout" Grid.Column="1" Orientation="Horizontal" Margin="10,5,12,6" Visibility="Collapsed">
                <TextBlock x:Name="CFps" Style="{StaticResource Value}" FontSize="16" FontWeight="Bold" MinWidth="30" VerticalAlignment="Center" />
                <TextBlock Text="FPS" Style="{StaticResource Unit}" FontWeight="SemiBold" Margin="3,0,0,2" />
                <StackPanel x:Name="CFrameTimeBox" Orientation="Horizontal">
                    <TextBlock x:Name="CFrameTime" Style="{StaticResource Value}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="ms" Style="{StaticResource Unit}" Margin="2,0,0,2" />
                </StackPanel>
                <StackPanel x:Name="CGpuBox" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="GPU" Style="{StaticResource Label}" Width="Auto" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CGpu" Style="{StaticResource Value}" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="CCpuBox" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="CPU" Style="{StaticResource Label}" Width="Auto" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CCpu" Style="{StaticResource Value}" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
                <Border x:Name="CLimit" Visibility="Collapsed" CornerRadius="3" Padding="5,0,5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CLimitText" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9" />
                </Border>
                <Border x:Name="CBadge" Visibility="Collapsed" Background="{StaticResource Accent}" CornerRadius="3"
                        Padding="5,0,5,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CBadgeText" FontFamily="Segoe UI" FontWeight="Bold" FontSize="8.5" Foreground="#0B0D10" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
